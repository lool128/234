-- ============================================
-- TOUCH INPUT (Tap to Select)
-- ============================================
UserInputService.TouchTapInWorld:Connect(function(position, processed)
    if processed then return end
    if not scriptActive then return end
    if rotationMode then return end
    if imanActivo then return end
    
    -- Ekranın alt %30'una dokunulursa ignore et (butonlar için)
    if position.Y > camera.ViewportSize.Y * 0.7 then return end
    
    -- Dokunulan yere raycast
    local result = raycastFromScreen(position)
    if result then
        local part = result.Instance
        if part:IsA("BasePart") and not esParteDePersonaje(part) and not part.Anchored then
            -- Sadece highlight göster, tutma için Grab butonu kullanılır
            highlightLooking.Adornee = part
            task.delay(0.5, function()
                if highlightLooking.Adornee == part then
                    highlightLooking.Adornee = nil
                end
            end)
        end
    end
end)

-- Touch drag for rotation mode
UserInputService.TouchMoved:Connect(function(touch, processed)
    if processed then return end
    if not rotationMode or not holding or not target then return end
    
    local delta = touch.Delta
    if math.abs(delta.X) > 0 or math.abs(delta.Y) > 0 then
        local rotationX = CFrame.fromAxisAngle(Vector3.new(0, 1, 0), math.rad(-delta.X * rotationSensitivity))
        local rotationY = CFrame.fromAxisAngle(Vector3.new(1, 0, 0), math.rad(-delta.Y * rotationSensitivity))
        
        if originalRotation then
            originalRotation = originalRotation * rotationX * rotationY
            gyro.CFrame = originalRotation + target.Position
        end
    end
end)

-- ============================================
-- RENDER STEPPED - GORSEL GUNCELLEMELER
-- ============================================
RunService.RenderStepped:Connect(function()
    if not scriptActive then return end
    
    -- Highlight güncelle
    if imanActivo and not holding then
        highlightHolding.Adornee = nil
        highlightLooking.Adornee = nil
    else
        if holding and target then
            highlightHolding.Adornee = target
            highlightLooking.Adornee = nil
        else
            highlightHolding.Adornee = nil
            -- Mobilde orta noktaya bak
            local screenCenter = Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y / 2)
            local result = raycastFromScreen(screenCenter)
            if result and result.Instance:IsA("BasePart") and not esParteDePersonaje(result.Instance) then
                highlightLooking.Adornee = result.Instance
            else
                highlightLooking.Adornee = nil
            end
        end
    end
    
    -- Rotasyon modu: kamera sabit, obje sabit
    if rotationMode and holding and target then
        if humanoidRootPart then
            humanoidRootPart.Velocity = Vector3.new(0, 0, 0)
        end
        if fixedCameraPosition and fixedCameraRotation then
            camera.CFrame = fixedCameraRotation + fixedCameraPosition
        end
        if fixedObjectPosition then
            positionLock.Velocity = Vector3.new(0, 0, 0)
            target.Position = fixedObjectPosition
        end
    end
end)

