local function restaurarPropiedadesOriginales()
    for obj, props in pairs(originalPhysicalProperties) do
        if obj and obj:IsDescendantOf(workspace) then 
            obj.CustomPhysicalProperties = props
        end
    end
    originalPhysicalProperties = {}
end

local function restaurarGravedad()
    for obj, oldGravity in pairs(gravityBackup) do
        if obj and obj:IsDescendantOf(workspace) then 
            obj.CustomPhysicalProperties = oldGravity
            gravityBackup[obj] = nil
        end
    end
    gravityBackup = {}
end

-- KARAKTER GIZLEME/GOSTERME
local function ocultarPersonaje()
    if not character then return end
    characterHidden = true
    for _, part in ipairs(character:GetDescendants()) do
        if part:IsA("BasePart") then
            originalCharacterVisibility[part] = part.Transparency
            part.Transparency = 1
        end
    end
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if humanoid then
        for _, accessory in ipairs(humanoid:GetChildren()) do
            if accessory:IsA("Accessory") then
                local handle = accessory:FindFirstChild("Handle")
                if handle then
                    originalCharacterVisibility[handle] = handle.Transparency
                    handle.Transparency = 1
                end
            end
        end
    end
end

local function mostrarPersonaje()
    if not characterHidden then return end
    characterHidden = false
    for part, transparency in pairs(originalCharacterVisibility) do
        if part and part:IsDescendantOf(workspace) then
            part.Transparency = transparency
        end
    end
    originalCharacterVisibility = {}
end

-- ============================================
-- RAYCAST (Mobil uyumlu)
-- ============================================
local function raycastFromScreen(screenPos)
    local ray = camera:ViewportPointToRay(screenPos.X, screenPos.Y)
    local raycastParams = RaycastParams.new()
    raycastParams.FilterDescendantsInstances = {character}
    raycastParams.FilterType = Enum.RaycastFilterType.Blacklist
    local result = workspace:Raycast(ray.Origin, ray.Direction * 1000, raycastParams)
    return result
end

local function getTargetFromScreen(screenPos)
    local result = raycastFromScreen(screenPos)
    if result then
        local part = result.Instance
        if part:IsA("BasePart") and not esParteDePersonaje(part) then
            return part, result.Position
        end
    end
    return nil, nil
end

-- ============================================
-- ANA FONKSIYONLAR
-- ============================================
function agarrarOSoltar()
    if not scriptActive then return end
    if imanActivo then return end
    if rotationMode then return end
    
    if holding then
        -- Birak
        originalRotation = nil
        vel.Parent, gyro.Parent, anchoredWhileHolding, target, holding = nil, nil, false, nil, false
        
        if rotationMode then
            rotationMode = false
            fixedCameraPosition = nil
            fixedCameraRotation = nil
            fixedObjectPosition = nil
            positionLock.Parent = nil
            mostrarPersonaje()
        end
        
        if target and originalPhysicalProperties[target] then
            target.CustomPhysicalProperties = originalPhysicalProperties[target]
            originalPhysicalProperties[target] = nil
        end
        
        grabBtn.Text = "🖐️ TUT"
        grabBtn.BackgroundColor3 = Color3.fromRGB(0, 150, 0)
        enviarNotificacion("✅ BIRAKILDI", "Obje serbest bırakıldı")
    else
        -- Tut (ekran ortasından raycast)
        local screenCenter = Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y / 2)
        local part, pos = getTargetFromScreen(screenCenter)
        
        if part and not part.Anchored then
            target = part
            anchoredWhileHolding = false
            originalRotation = part.CFrame - part.Position
            gyro.CFrame = originalRotation + part.Position
            gyro.Parent = part
            vel.Velocity = Vector3.zero
            vel.Parent = part
            
            if pos then
                holdDistance = (camera.CFrame.Position - pos).Magnitude
            else
                holdDistance = (camera.CFrame.Position - part.Position).Magnitude
            end
            holding = true
            
            grabBtn.Text = "✋ BIRAK"
            grabBtn.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
            enviarNotificacion("🖐️ TUTULDU", "Obje tutuluyor")
        elseif part and part.Anchored then
            enviarNotificacion("❌ HATA", "Obje sabitlenmiş!")
        else
            enviarNotificacion("❌ HATA", "Obje bulunamadı")
        end
    end
    actualizarInfo()
end

function lanzar()
    if not scriptActive then return end
    if imanActivo then return end
    if rotationMode then return end
    
    if holding and target then
        if anchoredWhileHolding then
            target.Anchored = false
            anchoredWhileHolding = false
        end
        
        vel.Parent = nil
        gyro.Parent = nil
        holding = false
        
        if originalPhysicalProperties[target] then
            target.CustomPhysicalProperties = originalPhysicalProperties[target]
            originalPhysicalProperties[target] = nil
        end
        
        local screenCenter = Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y / 2)
        local ray = camera:ViewportPointToRay(screenCenter.X, screenCenter.Y)
        local launchDirection = ray.Direction.Unit
        
        local impulse = Instance.new("BodyVelocity")
        impulse.Velocity = launchDirection * fuerzaLanzamiento
        impulse.MaxForce = Vector3.new(1,1,1) * 1e6
        impulse.P = 12500
        impulse.Parent = target
        Debris:AddItem(impulse, 0.5)
        
        grabBtn.Text = "🖐️ TUT"
        grabBtn.BackgroundColor3 = Color3.fromRGB(0, 150, 0)
        
        enviarNotificacion("🔥 FIRLATILDI", "Güç: " .. math.floor(fuerzaLanzamiento))
        target = nil
        actualizarInfo()
    else
        enviarNotificacion("❌ HATA", "Önce obje tutmalısın!")
    end
end

function alternarAnclado()
    if not scriptActive then return end
    if imanActivo then return end
    if rotationMode then return end
    
    if holding and target then
        anchoredWhileHolding = not anchoredWhileHolding
        target.Anchored = anchoredWhileHolding
        
        if anchoredWhileHolding then
            target:SetAttribute("TelekinesisAnchored", true)
            vel.Parent = nil
            gyro.Parent = nil
            target.AssemblyLinearVelocity = Vector3.zero
            target.AssemblyAngularVelocity = Vector3.zero
            
            enviarNotificacion("📌 SABITLENDI", "Obje havada kaldı")
            anchorBtn.Text = "📎 COZ"
            anchorBtn.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
        else
            target:SetAttribute("TelekinesisAnchored", nil)
            vel.Parent = target
            gyro.Parent = target
            
            enviarNotificacion("📎 COZULDU", "Obje tekrar hareket ediyor")
            anchorBtn.Text = "📌 SABITLE"
            anchorBtn.BackgroundColor3 = Color3.fromRGB(100, 100, 200)
        end
    else
        enviarNotificacion("❌ HATA", "Önce obje tutmalısın!")
    end
end

function alternarModoRotacion()
    if not holding or not target then
        enviarNotificacion("❌ HATA", "Önce obje tutmalısın!")
        return
    end
    
    rotationMode = not rotationMode
    
    if rotationMode then
        fixedCameraPosition = camera.CFrame.Position
        fixedCameraRotation = camera.CFrame - camera.CFrame.Position
        fixedObjectPosition = target.Position
        
        vel.Parent = nil
        positionLock.Velocity = Vector3.new(0, 0, 0)
        positionLock.Parent = target
        
        lastTouchPos = Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y / 2)
        
        ocultarPersonaje()
        
        rotateBtn.Text = "🔄 BITIR"
        rotateBtn.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
        
        enviarNotificacion("🔄 DONDURME MODU", "Ekrana sürükleyerek döndür")
    else
        fixedCameraPosition = nil
        fixedCameraRotation = nil
        fixedObjectPosition = nil
        rotationLabel = false
        
        positionLock.Parent = nil
        vel.Parent = target
        
        mostrarPersonaje()
        
        rotateBtn.Text = "🔄 DONDUR"
        rotateBtn.BackgroundColor3 = Color3.fromRGB(150, 0, 150)
        
        enviarNotificacion("✅ NORMAL MOD", "Döndürme bitti")
    end
    actualizarInfo()
end

function alternarIman()
    if not scriptActive then return end
    if holding then
        enviarNotificacion("❌ HATA", "Önce objeyi bırak!")
        return
    end
    
    imanActivo = not imanActivo
    if not imanActivo then
        restaurarPropiedadesOriginales()
        gravityBackup = {}
    end
    
    if imanActivo then
        magnetBtn.Text = "🧲 KAPAT"
        magnetBtn.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
        enviarNotificacion("🧲 MIKNATIS ACIK", "Etrafındaki objeleri çeker")
    else
        magnetBtn.Text = "🧲 MIKNATIS"
        magnetBtn.BackgroundColor3 = Color3.fromRGB(0, 100, 200)
        enviarNotificacion("🧲 MIKNATIS KAPALI", "Normal moda dönüldü")
    end
    actualizarInfo()
end

