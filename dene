CreateFeatureButton(CamTab, "FREECAM", Color3.fromRGB(100, 100, 255), function(active)
    freecamActive = active
    ClearTable(CamConns)
    if active then
        local camCF = Camera.CFrame
        local freecamPos = camCF.Position
        local freecamRot = Vector2.new(camCF.Rotation.X, camCF.Rotation.Y)
        local speed = 3

        local conn = RunService.RenderStepped:Connect(function()
            if not freecamActive then return end
            local delta = UIS:GetMouseDelta()
            freecamRot = freecamRot - Vector2.new(delta.Y, delta.X) * 0.3

            local move = Vector3.new(0, 0, 0)
            if UIS:IsKeyDown(Enum.KeyCode.W) then move = move + Vector3.new(0, 0, -1) end
            if UIS:IsKeyDown(Enum.KeyCode.S) then move = move + Vector3.new(0, 0, 1) end
            if UIS:IsKeyDown(Enum.KeyCode.A) then move = move + Vector3.new(-1, 0, 0) end
            if UIS:IsKeyDown(Enum.KeyCode.D) then move = move + Vector3.new(1, 0, 0) end
            if UIS:IsKeyDown(Enum.KeyCode.Space) then move = move + Vector3.new(0, 1, 0) end
            if UIS:IsKeyDown(Enum.KeyCode.LeftShift) then move = move + Vector3.new(0, -1, 0) end

            local rotCF = CFrame.Angles(0, math.rad(-freecamRot.Y), 0) * CFrame.Angles(math.rad(-freecamRot.X), 0, 0)
            freecamPos = freecamPos + (rotCF * move * speed)
            Camera.CFrame = rotCF + freecamPos
            Camera.CameraType = Enum.CameraType.Scriptable
        end)
        table.insert(CamConns, conn)
    else
        Camera.CameraType = Enum.CameraType.Custom
        if isModeOn and FakeChar and FakeChar:FindFirstChildOfClass("Humanoid") then
            Camera.CameraSubject = FakeChar:FindFirstChildOfClass("Humanoid")
        elseif Player.Character and Player.Character:FindFirstChildOfClass("Humanoid") then
            Camera.CameraSubject = Player.Character:FindFirstChildOfClass("Humanoid")
        end
    end
end)

