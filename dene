local function CreateFeatureButton(parent, text, color, callback)
    local Container = Instance.new("Frame")
    Container.Size = UDim2.new(0, 175, 0, 42)
    Container.BackgroundTransparency = 1
    Container.Parent = parent

    local Btn = Instance.new("TextButton")
    Btn.Size = UDim2.new(1, 0, 1, 0)
    Btn.BackgroundColor3 = color or Color3.fromRGB(50, 50, 60)
    Btn.Text = text
    Btn.TextColor3 = Color3.new(1, 1, 1)
    Btn.Font = Enum.Font.GothamBold
    Btn.TextSize = 11
    Btn.Parent = Container
    CreateCorner(Btn)
    CreateStroke(Btn, Color3.fromRGB(0, 0, 0), 1)

    local active = false
    Btn.MouseButton1Click:Connect(function()
        active = not active
        if active then
            Tween(Btn, {BackgroundColor3 = Color3.fromRGB(0, 200, 100)}, 0.2)
        else
            Tween(Btn, {BackgroundColor3 = color or Color3.fromRGB(50, 50, 60)}, 0.2)
        end
        callback(active, Btn)
    end)
    return Btn, Container
end

local function CreateValueBox(parent, placeholder, default)
    local Container = Instance.new("Frame")
    Container.Size = UDim2.new(0, 175, 0, 36)
    Container.BackgroundTransparency = 1
    Container.Parent = parent

    local Box = Instance.new("TextBox")
    Box.Size = UDim2.new(1, 0, 1, 0)
    Box.BackgroundColor3 = Color3.fromRGB(40, 40, 48)
    Box.TextColor3 = Color3.new(1, 1, 1)
    Box.Font = Enum.Font.GothamSemibold
    Box.TextSize = 13
    Box.Text = tostring(default)
    Box.PlaceholderText = placeholder
    Box.Parent = Container
    CreateCorner(Box)
    CreateStroke(Box, UI_COLOR, 1)
    return Box, Container
end

