-- SUNUCU ATLAMA (Servers.JSON önbellekli sistem)
-- Config.Farm kapalıysa veya Config.Stay açıksa sunucu değiştirmez.
-- ════════════════════════════════════════════════════
local PromptsRemoved = false
local function ServerHopRun()
    if not Config.Farm or Config.Stay then
        return
    end

    local HttpService = game:GetService("HttpService")
    local CoreGui = game:GetService("CoreGui")
    local LocalPlayer = Players.LocalPlayer

    local RemoveErrorPrompts = true  -- hata pencerelerinin çıkmasını engeller
    local IterationSpeed = 0.25      -- sıradaki sunucuya geçme hızı
    local ExcludefullServers = true
    local SaveTeleportAttempts = false
    local API = "https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?limit=100"

    if RemoveErrorPrompts and not PromptsRemoved then
        PromptsRemoved = true
        pcall(function()
            local Gui = CoreGui:WaitForChild("RobloxGui", 5)
            local Modules = Gui and Gui:WaitForChild("Modules", 5)
            local Prompt = Modules and Modules:WaitForChild("ErrorPrompt", 5)
            if Prompt then Prompt:Destroy() end
        end)
        pcall(function()
            local PromptGui = CoreGui:FindFirstChild("RobloxPromptGui")
            if PromptGui then PromptGui:Destroy() end
        end)
    end

    local function ShouldStop()
        return not Config.Farm or Config.Stay
    end

    local function EncodeToFile(JSONString)
        if type(JSONString) ~= "string" or JSONString == "" then
            return nil
        end
        local ok, Data = pcall(function()
            return HttpService:JSONDecode(JSONString)
        end)
        if not ok or type(Data) ~= "table" or type(Data.data) ~= "table" then
            warn("[Server Hop] JSON çözülemedi.")
            return nil
        end
        Data.gameId = game.PlaceId
        pcall(function()
            writefile("Servers.JSON", HttpService:JSONEncode(Data))
        end)
        return Data
    end

    local function Fetch(Cursor)
        local Url = API .. "&excludeFullGames=" .. tostring(ExcludefullServers)
        if Cursor and Cursor ~= "" then
            Url ..= "&cursor=" .. Cursor
        end
        local ok, Result = pcall(function()
            return game:HttpGet(Url)
        end)
        if ok and type(Result) == "string" and Result ~= "" then
            return Result
        end
        warn("[Server Hop] Sunucu listesi alınamadı: " .. tostring(Result))
        return nil
    end

    local function NextCursor(Cursor)
        return EncodeToFile(Fetch(Cursor))
    end

    local function SetMainPage()
        return EncodeToFile(Fetch(nil))
    end

    local function LoadCache()
        local ok, Data = pcall(function()
            if isfile and isfile("Servers.JSON") then
                return HttpService:JSONDecode(readfile("Servers.JSON"))
            end
        end)
        if ok and type(Data) == "table" and type(Data.data) == "table" then
            return Data
        end
        return nil
    end

    -- Önbelleği yükle, başka oyuna aitse veya bozuksa baştan al
    local Data = LoadCache()
    if not Data or Data.gameId ~= game.PlaceId then
        if Data then
            warn("[Server Hop] Önbellek başka oyuna ait, yenileniyor -> " .. game.PlaceId)
        end
        Data = SetMainPage()
    end

    if Data and #Data.data < 1 then
        if Data.nextPageCursor and Data.nextPageCursor ~= "" then
            Data = NextCursor(Data.nextPageCursor)
        else
            Data = SetMainPage() -- sayfa kalmadı, baştan başla
        end
    end

    if not Data then
        task.wait(3)
        return
    end

    local PagesFetched = 0

    while Data and not ShouldStop() do
        local Entry = table.remove(Data.data, 1)

        if not Entry then
            -- Bu sayfa bitti, sıradaki sayfaya geç
            PagesFetched += 1
            if PagesFetched >= 20 then
                break
            end
            if Data.nextPageCursor and Data.nextPageCursor ~= "" then
                Data = NextCursor(Data.nextPageCursor)
            else
                Data = SetMainPage()
            end
            if not Data then
                task.wait(2)
                break
            end
            continue
        end

        local JobId = Entry.id
        local Playing = tonumber(Entry.playing) or 0
        local MaxPlayers = tonumber(Entry.maxPlayers) or math.huge

        -- Kullanılan sunucu listeden silinmiş halde dosyaya yazılır
        pcall(function()
            writefile("Servers.JSON", HttpService:JSONEncode(Data))
        end)

        if type(JobId) == "string" and JobId ~= "" and JobId ~= game.JobId
            and Playing < MaxPlayers then

            if SaveTeleportAttempts then
                pcall(function()
                    appendfile("Attempts.txt", JobId .. "\n")
                end)
            end

            SetFarmStatus("yeni sunucuya geçiliyor...")
            local BeforeJobId = game.JobId
            local TeleportOk, TeleportError = pcall(function()
                TeleportService:TeleportToPlaceInstance(game.PlaceId, JobId, LocalPlayer)
            end)

            if not TeleportOk then
                warn("[Server Hop] Teleport çağrısı başarısız: " .. tostring(TeleportError))
            end

            task.wait(IterationSpeed + HopBackoff())
            if game.JobId ~= BeforeJobId then
                return
            end
        end
    end

    if not ShouldStop() then
        task.wait(2)
    end
end

-- Butonlara tepki veren bekleme: ayar degisirse false doner
local function WaitSeconds(Seconds)
    local FarmAtStart, StayAtStart = Config.Farm, Config.Stay
    local Elapsed = 0
    while Elapsed < Seconds do
        task.wait(0.25)
        Elapsed += 0.25
        if FpsHopRequested then
            return true
        end
        if Config.Farm ~= FarmAtStart then
            return false
        end
        if Config.Stay ~= StayAtStart then
            -- "Kal" kapatildiysa beklemeyi bitir ve hemen atla, acildiysa atlama
            return not Config.Stay
        end
    end
    return true
end

