-- HOP HATA SAYACI (üst üste başarısız ışınlanmada bekleme artar)
-- Başarılı ışınlanmada script yeni sunucuda baştan başladığı için sayaç otomatik sıfırlanır.
-- ════════════════════════════════════════════════════
local HopFails = 0

local function HopBackoff()
    -- her hata +2 sn ekstra bekleme, en fazla 30 sn
    return math.min(HopFails * 2, 30)
end

TeleportService.TeleportInitFailed:Connect(function(_, Result)
    -- "zaten ışınlanıyor" hatası gerçek bir hata sayılmaz
    if Result and Result.Name == "IsTeleporting" then
        return
    end

    HopFails += 1
    warn(("[Server Hop] Işınlanma hatası #%d (%s) - ekstra bekleme: %d sn"):format(
        HopFails, tostring(Result), HopBackoff()))
    SetFarmStatus(("ışınlanma hatası x%d, +%d sn bekleniyor"):format(HopFails, HopBackoff()))
end)

-- ════════════════════════════════════════════════════
-- KICK / BAĞLANTI KOPMASI SONRASI OTOMATİK TEKRAR GİRİŞ
-- (Işınlanma hataları hop sistemine aittir, burada işlenmez)
-- ════════════════════════════════════════════════════
do
    local GuiService = game:GetService("GuiService")
    local Rejoining = false

    local function TryRejoin()
        if Rejoining or not Config.AutoRejoin then
            return
        end
        Rejoining = true

        task.spawn(function()
            task.wait(2)

            for Attempt = 1, 15 do
                if not Config.AutoRejoin then
                    break
                end

                SetFarmStatus(("bağlantı koptu, tekrar giriliyor (%d)..."):format(Attempt))
                QueueSelf()

                pcall(function()
                    TeleportService:Teleport(game.PlaceId, LocalPlayer)
                end)

                -- Hâlâ buradaysak ışınlanma olmadı, biraz bekleyip tekrar dene
                task.wait(5 + math.min(Attempt * 2, 20))
            end

            Rejoining = false
        end)
    end

    GuiService.ErrorMessageChanged:Connect(function()
        local Message = GuiService:GetErrorMessage()
        if not Message or Message == "" then
            return
        end

        local Ok, Code = pcall(function()
            return GuiService:GetErrorCode()
        end)

        -- Teleport hata kodları (768+) hop sistemine ait, onları atla
        if Ok and Code and Code.Value >= Enum.ConnectionError.TeleportErrors.Value then
            return
        end

        warn("[Auto Rejoin] Bağlantı hatası: " .. tostring(Message))
        TryRejoin()
    end)
end

