local function FindGoldStat()
    local function isNum(v)
        return v:IsA("IntValue") or v:IsA("NumberValue")
    end

    if GoldStatName then
        for _, v in ipairs(LocalPlayer:GetDescendants()) do
            if v.Name == GoldStatName and isNum(v) then
                return v
            end
        end
        return nil
    end

    local Leader = LocalPlayer:FindFirstChild("leaderstats")
    local Pools = {}
    if Leader then
        table.insert(Pools, Leader:GetChildren())
    end
    table.insert(Pools, LocalPlayer:GetDescendants())

    -- "gold" öncelikli, sonra diğer para isimleri
    local Keys = { "gold", "money", "cash", "coin", "para", "candy", "eker", "gem" }
    for _, Pool in ipairs(Pools) do
        for _, Key in ipairs(Keys) do
            for _, v in ipairs(Pool) do
                if isNum(v) and string.find(string.lower(v.Name), Key, 1, true) then
                    return v
                end
            end
        end
    end

    if Leader then
        for _, v in ipairs(Leader:GetChildren()) do
            if isNum(v) then
                return v
            end
        end
    end
    return nil
end

