    lbl.RichText = true

    local function set(Text, IsError)
        local Col = IsError and C.RED or statusColor(Text)
        lbl.Text = ('<font color="#%s">●</font>  %s'):format(Col:ToHex(), escapeRich(Text))
    end
    set(initialText or "")

    return card, set
