-- ── FPS İZLEME (ekranda gösterilmez) ──
-- FPS belli süre üst üste düşük kalırsa ("FPS düşünce atla" açıksa) farm sunucu değiştirir.
local FpsMin        = 20   -- bu değerin altı "düşük" sayılır
local FpsLowSeconds = 8    -- bu kadar sn üst üste düşük kalırsa atla
local FpsGrace      = 25   -- sunucuya girince ilk bu kadar sn FPS'e bakma (yükleme anı)

local FpsHopRequested = false
local FpsGraceUntil   = os.clock() + FpsGrace

do
    local RunService = game:GetService("RunService")
    local Frames, LastTick, LowFor = 0, os.clock(), 0

    RunService.Heartbeat:Connect(function()
        Frames += 1
    end)

    task.spawn(function()
        while true do
            task.wait(0.5)
            local Now = os.clock()
            local Fps = Frames / math.max(Now - LastTick, 0.001)
            Frames, LastTick = 0, Now

            if not Config.AutoFpsHop or not Config.Farm or Config.Stay then
                FpsHopRequested = false
                LowFor = 0
            elseif Now < FpsGraceUntil then
                LowFor = 0
            elseif Fps < FpsMin then
                LowFor += 0.5
                if LowFor >= FpsLowSeconds and not FpsHopRequested then
                    FpsHopRequested = true
                    LowFor = 0
                    warn(("[FPS] %d FPS, %d sn düşük kaldı, sunucu değiştiriliyor"):format(math.floor(Fps), FpsLowSeconds))
                    SetFarmStatus("FPS düşük, sunucu değiştiriliyor...")
                end
            else
                LowFor = 0
            end
        end
    end)
end

