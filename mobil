-- Sürükleme (fare + dokunmatik). Hedef her zaman ekranın içinde kalır.
-- Bırakma olayı InputEnded ile yakalanır, 8 pikselden az hareket "dokunuş" sayılır.
local function makeDraggable(handle, target, onTap)
    local active, isMouse, startInput, startPos, startTL, moved = false, false, nil, nil, nil, false

    local function place(x, y)
        local V = sg.AbsoluteSize
        if V.X <= 0 or V.Y <= 0 then
            return
        end
        local S = target.AbsoluteSize
        local H = math.min(S.Y, 48 * (target == panel and panelScale.Scale or 1))
        x = math.clamp(x, 0, math.max(0, V.X - S.X))
        y = math.clamp(y, 0, math.max(0, V.Y - H))
        target.Position = UDim2.fromScale(x / V.X, y / V.Y)
    end

    handle.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1
            or i.UserInputType == Enum.UserInputType.Touch then
            active     = true
            moved      = false
            startInput = i
            isMouse    = i.UserInputType == Enum.UserInputType.MouseButton1
            startPos   = i.Position
            startTL    = target.AbsolutePosition
        end
    end)

    UserInputService.InputChanged:Connect(function(i)
        if not active then
            return
        end

        if isMouse then
            if i.UserInputType ~= Enum.UserInputType.MouseMovement then
                return
            end
            if not UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) then
                active = false
                return
            end
        elseif i ~= startInput then
            return
        end

        local d = i.Position - startPos
        if not moved and d.Magnitude < 8 then
            return
        end
        moved = true
        place(startTL.X + d.X, startTL.Y + d.Y)
    end)

    UserInputService.InputEnded:Connect(function(i)
        if not active then
            return
        end
        if (isMouse and i.UserInputType == Enum.UserInputType.MouseButton1)
            or (not isMouse and i == startInput) then
            active = false
            if not moved and onTap then
                onTap()
            end
        end
    end)

    -- Mevcut konumu ekran sınırlarına geri çeker
    return function()
        local p = target.AbsolutePosition
        place(p.X, p.Y)
    end
end

