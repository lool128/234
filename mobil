        sz    = UDim2.new(1, -54, 0, 16),
        pos   = UDim2.new(0, 36, 0, 37),
    })

    local function set(Text, IsError)
        lbl.Text = Text
        tween(dot, { BackgroundColor3 = IsError and C.RED or statusColor(Text) }, 0.2)
