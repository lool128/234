-- HOP HATA SAYACI (üst üste başarısız ışınlanmada bekleme artar)
-- Başarılı ışınlanmada script yeni sunucuda baştan başladığı için sayaç otomatik sıfırlanır.
-- ════════════════════════════════════════════════════
local HopFails = 0

local function HopBackoff()
    -- her hata +2 sn ekstra bekleme, en fazla 30 sn
    return math.min(HopFails * 2, 30)
end

TeleportService.TeleportInitFailed:Connect(function(_, Result)
    -- "zaten ışınlanıyor" hatası gerçek bir hata sayılmaz
    if Result and Result.Name == "IsTeleporting" then
        return
    end

    HopFails += 1
    warn(("[Server Hop] Işınlanma hatası #%d (%s) - ekstra bekleme: %d sn"):format(
        HopFails, tostring(Result), HopBackoff()))
    SetFarmStatus(("ışınlanma hatası x%d, +%d sn bekleniyor"):format(HopFails, HopBackoff()))
end)

