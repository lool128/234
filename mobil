-- FARM MANTIĞI
-- ════════════════════════════════════════════════════
local Houses, HouseList, HouseCount = nil, {}, 0

local function GetRoot()
    while true do
        local Character = Player.Character
        local Hrp = Character and Character:FindFirstChild("HumanoidRootPart")

        if Hrp and Hrp:IsDescendantOf(workspace) then
            return Character, Hrp
        end

        task.wait(0.1)
    end
end

local function CollectHouses()
    -- Her turda ev listesini yeniden al
    HouseList = Houses:GetChildren()
    HouseCount = #HouseList
    local Fired, Skipped = 0, 0

    for _, House in ipairs(HouseList) do
        if not Config.Farm then
            return
        end

        local Door = House:FindFirstChild("Door")
        local TouchPart = Door and Door:FindFirstChild("DoorInnerTouch")

        if not TouchPart or not TouchPart:IsA("BasePart") then
            Skipped += 1
            continue
        end

        if not TouchPart:FindFirstChild("TouchInterest") then
            Skipped += 1
            continue
        end

        Fired += 1
        local Character, Hrp = GetRoot()

        local Success, ErrorMessage = pcall(function()
            if not TouchPart:IsDescendantOf(workspace) then
                return
            end

            firetouchinterest(Hrp, TouchPart, 0)
            task.wait(0.2)

            if Player.Character == Character
                and Hrp:IsDescendantOf(workspace)
                and TouchPart:IsDescendantOf(workspace) then
                firetouchinterest(Hrp, TouchPart, 1)
            end
        end)

        if not Success then
            warn(("[House Collector] %s: %s"):format(House.Name, tostring(ErrorMessage)))
        end
    end

    print(("[House Collector] Tur bitti: %d ev tetiklendi, %d ev atlandi (TouchInterest yok)"):format(Fired, Skipped))
end

