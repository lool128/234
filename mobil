    local bar = Instance.new("Frame")
    bar.Size             = UDim2.new(0, 36, 0, 3)
    bar.Position         = UDim2.new(0.5, -18, 0, 7)
    bar.BackgroundColor3 = accent
    bar.BorderSizePixel  = 0
    bar.Parent           = card
    corner(bar, 2)

    label(card, {
        text  = title,
        font  = Enum.Font.GothamBold,
        size  = 14,
        color = accent,
        align = CENTER,
        sz    = UDim2.new(1, -24, 0, 20),
        pos   = UDim2.new(0, 12, 0, 14),
    })

    local lbl = label(card, {
        text  = "",
        size  = 11,
        color = C.TEXT,
        align = CENTER,
        sz    = UDim2.new(1, -24, 0, 16),
        pos   = UDim2.new(0, 12, 0, 38),
