-- YARDIMCI FONKSİYONLAR
-- ════════════════════════════════════════════════════
local function tween(obj, props, t)
    pcall(function()
        TweenService:Create(
            obj,
            TweenInfo.new(t or 0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
            props
        ):Play()
    end)
end

local function corner(parent, radius)
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, radius or 8)
    c.Parent = parent
    return c
end

local function stroke(parent, color, thickness)
    local s = Instance.new("UIStroke")
    s.Name      = "Stroke"
    s.Color     = color or Color3.fromRGB(50, 50, 80)
    s.Thickness = thickness or 1
    s.Parent    = parent
    return s
end

local function padding(parent, px, py)
    local p  = Instance.new("UIPadding")
    local ux = UDim.new(0, px)
    local uy = UDim.new(0, py or px)
    p.PaddingLeft   = ux
    p.PaddingRight  = ux
    p.PaddingTop    = uy
    p.PaddingBottom = uy
    p.Parent = parent
    return p
end


local function gradient(parent, c0, c1, rotation)
    local g = Instance.new("UIGradient")
    g.Color    = ColorSequence.new(c0, c1)
    g.Rotation = rotation or 0
    g.Parent   = parent
    return g
end

local function label(parent, props)
    local l = Instance.new("TextLabel")
    l.BackgroundTransparency = 1
    l.Font           = props.font  or Enum.Font.Gotham
    l.TextSize       = props.size  or 12
    l.TextColor3     = props.color or C.TEXT
    l.Text           = props.text  or ""
    l.TextXAlignment = props.align or Enum.TextXAlignment.Left
    l.TextTruncate   = props.wrap and Enum.TextTruncate.None or Enum.TextTruncate.AtEnd
    l.TextWrapped    = props.wrap  or false
    l.Size           = props.sz    or UDim2.new(1, 0, 0, 16)
    l.Position       = props.pos   or UDim2.new(0, 0, 0, 0)
    l.Parent         = parent
    return l
end

local function button(parent, props)
    local b = Instance.new("TextButton")
    b.BackgroundColor3 = props.bg    or C.BG3
    b.BorderSizePixel  = 0
    b.Text             = props.text  or ""
    b.TextColor3       = props.color or C.PURPLE
    b.Font             = props.font  or Enum.Font.GothamBold
    b.TextSize         = props.size  or 12
    b.AutoButtonColor  = false
    b.Size             = props.sz    or UDim2.new(1, 0, 0, 32)
    b.Position         = props.pos   or UDim2.new(0, 0, 0, 0)
    b.Parent           = parent
    corner(b, props.radius or 8)
    local hoverBg  = props.hoverBg or C.PURPLE_DK
    local normalBg = props.bg      or C.BG3
    b.MouseEnter:Connect(function() tween(b, { BackgroundColor3 = hoverBg  }, 0.12) end)
    b.MouseLeave:Connect(function() tween(b, { BackgroundColor3 = normalBg }, 0.12) end)
    return b
end

local function badge(parent, txt, bg, fg, xOff, yOff, width)
    local f = Instance.new("Frame")
    f.Size             = UDim2.new(0, width or 56, 0, 18)
    f.Position         = UDim2.new(1, xOff or -64, 0, yOff or 6)
    f.BackgroundColor3 = bg or C.BG3
    f.BorderSizePixel  = 0
    f.Parent           = parent
    corner(f, 9)
    stroke(f, (fg or C.TEXT):Lerp(C.BG, 0.7), 1)
    local l = Instance.new("TextLabel")
    l.Size             = UDim2.new(1, 0, 1, 0)
    l.BackgroundTransparency = 1
    l.Text             = txt
    l.TextColor3       = fg or C.TEXT
    l.Font             = Enum.Font.GothamSemibold
    l.TextSize         = 10
    l.Parent           = f
    return f, l
end


local function statusColor(Text)
    if string.find(Text, "hata", 1, true)
        or string.find(Text, "koptu", 1, true)
        or string.find(Text, "bulunamadı", 1, true) then
        return C.RED
    end
    if string.find(Text, "kapalı", 1, true) then
        return C.MUTED
    end
    if string.find(Text, "bekl", 1, true) or string.find(Text, "aran", 1, true) then
        return C.ORANGE
    end
    return C.GREEN
end


local function infoCard(parent, title, accent, initialText)
    local card = Instance.new("Frame")
    card.Size             = UDim2.new(1, -6, 0, 64)
