CreateFeatureButton(ESPTab, "ESP AÇ/KAPA", Color3.fromRGB(255, 50, 150), function(active)
    espActive = active
    if active then
        local function CreateESP(plr)
            if plr == Player then return end
            if ESPObjects[plr] then return end
            
            local espFolder = Instance.new("Folder")
            espFolder.Name = plr.Name .. "_ESP"
            espFolder.Parent = ScreenGui
            ESPObjects[plr] = espFolder
            
            local box = Instance.new("Frame")
            box.Name = "Box"
            box.Size = UDim2.new(0, 80, 0, 100)
            box.BackgroundColor3 = Color3.fromRGB(255, 0, 0)
            box.BackgroundTransparency = 0.8
            box.BorderSizePixel = 0
            box.Parent = espFolder
            
            local nameTag = Instance.new("TextLabel")
            nameTag.Name = "Name"
            nameTag.Size = UDim2.new(0, 100, 0, 20)
            nameTag.BackgroundTransparency = 1
            nameTag.TextColor3 = Color3.fromRGB(255, 255, 255)
            nameTag.Font = Enum.Font.GothamBold
            nameTag.TextSize = 12
            nameTag.Parent = espFolder
            
            local distTag = Instance.new("TextLabel")
            distTag.Name = "Dist"
            distTag.Size = UDim2.new(0, 100, 0, 18)
            distTag.BackgroundTransparency = 1
            distTag.TextColor3 = Color3.fromRGB(0, 255, 255)
            distTag.Font = Enum.Font.GothamBold
            distTag.TextSize = 11
            distTag.Parent = espFolder
            
            local conn = RunService.RenderStepped:Connect(function()
                if not espActive or not ESPObjects[plr] then return end
                local char = plr.Character
                if not char then
                    box.Visible = false
                    nameTag.Visible = false
                    distTag.Visible = false
                    return
                end
                local root = char:FindFirstChild("HumanoidRootPart")
                local hum = char:FindFirstChild("Humanoid")
                if not root or not hum then
                    box.Visible = false
                    nameTag.Visible = false
                    distTag.Visible = false
                    return
                end
                
                local pos, onScreen = Camera:WorldToViewportPoint(root.Position)
                if not onScreen then
                    box.Visible = false
                    nameTag.Visible = false
                    distTag.Visible = false
                    return
                end
                
                box.Visible = true
                nameTag.Visible = true
                distTag.Visible = true
                
                box.Position = UDim2.new(0, pos.X - 40, 0, pos.Y - 50)
                nameTag.Position = UDim2.new(0, pos.X - 50, 0, pos.Y - 70)
                distTag.Position = UDim2.new(0, pos.X - 50, 0, pos.Y + 55)
                
                nameTag.Text = plr.Name .. " [" .. math.floor(hum.Health) .. "/" .. math.floor(hum.MaxHealth) .. "]"
                local dist = (Camera.CFrame.Position - root.Position).Magnitude
                distTag.Text = string.format("%.1f m", dist)
            end)
            table.insert(ESPConns, conn)
        end
        
        for _, plr in pairs(Players:GetPlayers()) do
            CreateESP(plr)
        end
        local addedConn = Players.PlayerAdded:Connect(CreateESP)
        table.insert(ESPConns, addedConn)
    else
        for _, conn in pairs(ESPConns) do SafeDisconnect(conn) end
        table.clear(ESPConns)
        for _, obj in pairs(ESPObjects) do obj:Destroy() end
        table.clear(ESPObjects)
    end
end)

