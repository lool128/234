CreateFeatureButton(CameraTab, "FREECAM", Color3.fromRGB(100, 100, 255), function(active)
    freecamActive = active
    if active then
        local camCF = Camera.CFrame
        local freecamPos = camCF.Position
        local freecamRot = Vector2.new(camCF.Rotation.X, camCF.Rotation.Y)
        local speed = 2
        
        local conn = RunService.RenderStepped:Connect(function()
            if not freecamActive then return end
            local delta = UserInputService:GetMouseDelta()
            freecamRot = freecamRot - Vector2.new(delta.Y, delta.X) * 0.3
            
            local move = Vector3.new(0, 0, 0)
            if UserInputService:IsKeyDown(Enum.KeyCode.W) then move = move + Vector3.new(0, 0, -1) end
            if UserInputService:IsKeyDown(Enum.KeyCode.S) then move = move + Vector3.new(0, 0, 1) end
            if UserInputService:IsKeyDown(Enum.KeyCode.A) then move = move + Vector3.new(-1, 0, 0) end
            if UserInputService:IsKeyDown(Enum.KeyCode.D) then move = move + Vector3.new(1, 0, 0) end
            if UserInputService:IsKeyDown(Enum.KeyCode.Space) then move = move + Vector3.new(0, 1, 0) end
            if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then move = move + Vector3.new(0, -1, 0) end
            
            local rotCF = CFrame.Angles(0, math.rad(-freecamRot.Y), 0) * CFrame.Angles(math.rad(-freecamRot.X), 0, 0)
            freecamPos = freecamPos + (rotCF * move * speed)
            Camera.CFrame = rotCF + freecamPos
            Camera.CameraType = Enum.CameraType.Scriptable
        end)
        table.insert(MiscConns, conn)
    else
        for i = #MiscConns, 1, -1 do
            SafeDisconnect(MiscConns[i])
            table.remove(MiscConns, i)
        end
        Camera.CameraType = Enum.CameraType.Custom
        if isModeOn and FakeChar and FakeChar:FindFirstChild("Humanoid") then
            Camera.CameraSubject = FakeChar.Humanoid
        elseif Player.Character and Player.Character:FindFirstChild("Humanoid") then
            Camera.CameraSubject = Player.Character.Humanoid
        end
    end
end)

