local function CreateFeatureButton(parent, text, color, callback)
    local Btn = Instance.new("TextButton")
    Btn.Size = UDim2.new(1, 0, 1, 0)
    Btn.BackgroundColor3 = color or Color3.fromRGB(50, 50, 60)
    Btn.Text = text
    Btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    Btn.Font = Enum.Font.GothamBold
    Btn.TextSize = 12
    Btn.Parent = parent
    CreateCorner(Btn)
    CreateStroke(Btn, Color3.fromRGB(0, 0, 0), 1)
    
    local active = false
    Btn.MouseButton1Click:Connect(function()
        active = not active
        if active then
            Tween(Btn, {BackgroundColor3 = Color3.fromRGB(0, 200, 100)}, 0.2)
        else
            Tween(Btn, {BackgroundColor3 = color or Color3.fromRGB(50, 50, 60)}, 0.2)
        end
        callback(active)
    end)
    return Btn
end

local function CreateValueBox(parent, placeholder, default)
    local Box = Instance.new("TextBox")
    Box.Size = UDim2.new(1, 0, 1, 0)
    Box.BackgroundColor3 = Color3.fromRGB(45, 45, 55)
    Box.TextColor3 = Color3.fromRGB(255, 255, 255)
    Box.Font = Enum.Font.GothamSemibold
    Box.TextSize = 13
    Box.Text = tostring(default)
    Box.PlaceholderText = placeholder
    Box.Parent = parent
    CreateCorner(Box)
    CreateStroke(Box, Color3.fromRGB(0, 170, 255), 1)
    return Box
end

