local function WaitPath(Parent, Timeout, ...)
    local Current = Parent
    for _, Name in ipairs({ ... }) do
        Current = Current and Current:WaitForChild(Name, Timeout)
    end
    return Current
end

local function LoadGoodlRefs()
    if Goodl.Refs then
        return Goodl.Refs
    end

    local OtherData = WaitPath(LocalPlayer, 10, "OtherData")
    local EndData   = OtherData and OtherData:WaitForChild("End", 10)
    local Stages    = WaitPath(workspace, 10, "BoatStages", "NormalStages")
    local Chest     = Stages and WaitPath(Stages, 10, "TheEnd", "GoldenChest", "Trigger")
    local Claim     = WaitPath(workspace, 10, "ClaimRiverResultsGold")

    if not (OtherData and EndData and Stages and Chest and Claim) then
        return nil
    end

    Goodl.Refs = {
        OtherData    = OtherData,
        EndData      = EndData,
        Stages       = Stages,
        ChestTrigger = Chest,
        ClaimRemote  = Claim,
    }
    return Goodl.Refs
end

local function GoodlAlive(Token, Hum)
    return Goodl.Token == Token and Hum.Parent ~= nil and Hum.Health > 0
end

local function GoodlCollectStage(Refs, Token, Char, Hum, StageNumber)
    local Stage     = Refs.Stages:FindFirstChild("CaveStage" .. StageNumber)
    local Collect   = Stage and Stage:FindFirstChild("DarknessPart")
    local StageData = Refs.OtherData:FindFirstChild("Stage" .. (StageNumber - 1))

    if not (Collect and StageData) then
        return
    end

    repeat
        task.wait()

        Char:PivotTo(Collect.CFrame * CFrame.new(0, 0, -20))

        for _, BodyPart in ipairs(Char:GetChildren()) do
            if BodyPart:IsA("BasePart") then
                BodyPart.Velocity, BodyPart.RotVelocity = Vector3.zero, Vector3.zero
            end
        end
    until StageData.Value ~= "" or not GoodlAlive(Token, Hum)
end

local function GoodlTouchChest(Refs, Token, Char, Hum)
    task.spawn(function()
        repeat
            local Old = Refs.ChestTrigger.CFrame
            Refs.ChestTrigger.CFrame = Char:GetPivot()
            task.wait()
            Refs.ChestTrigger.CFrame = Old
        until Refs.EndData.Value ~= "" or not GoodlAlive(Token, Hum)
    end)
end

local function GoodlFarm(Token)
    local Refs = Goodl.Refs
    local Char = LocalPlayer.Character
    if not Refs or not Char then
        return
    end

    local Hum = Char:WaitForChild("Humanoid", 10)
    if not Hum or not Char:WaitForChild("HumanoidRootPart", 10) then
        return
    end

    for StageNumber = Goodl.StartStage, 10 do
        if not GoodlAlive(Token, Hum) then
            return
        end

        SetGoodlStatus("stage " .. StageNumber .. " toplanıyor...")
        GoodlCollectStage(Refs, Token, Char, Hum, StageNumber)

        if not GoodlAlive(Token, Hum) then
            return
        end

        if StageNumber ~= Goodl.ChestClaimStage then
            if Goodl.AutoClaim then
                Refs.ClaimRemote:FireServer()
            end
        elseif Goodl.ClaimChest then
            task.spawn(function()
                task.wait(Goodl.ChestClaimDelay)
                if GoodlAlive(Token, Hum) then
                    GoodlTouchChest(Refs, Token, Char, Hum)
                end
            end)
        elseif Goodl.AutoClaim then
            Refs.ClaimRemote:FireServer()
        end
    end

    if Goodl.Token == Token then
        SetGoodlStatus("tur bitti, sıfırlanıyor...")
        Char:BreakJoints()
    end
end

local function StopGoodl()
    Goodl.Token += 1
    Goodl.Mode = nil

    if Goodl.Conn then
        Goodl.Conn:Disconnect()
        Goodl.Conn = nil
    end

    Config.Goodl = "off"
    SaveConfig()
    RefreshGoodl()
    SetGoodlStatus("kapalı")
end

local function StartGoodl(Mode, IsRestore)
    if Goodl.Loading then
        return
    end

    -- aynı butona tekrar basınca kapat
    if Goodl.Mode == Mode then
        StopGoodl()
        return
    end

    local WasRunning = Goodl.Mode ~= nil

    if not WasRunning then
        Goodl.Loading = true
        SetGoodlStatus("oyun verisi aranıyor...")
        local Refs = LoadGoodlRefs()
        Goodl.Loading = false

        if not Refs then
            SetGoodlStatus("bu haritada GOODL verisi bulunamadı", true)
            if not IsRestore then
                Config.Goodl = "off"
                SaveConfig()
            end
            RefreshGoodl()
            return
        end
    end

    Goodl.Mode       = Mode
    Goodl.ClaimChest = (Mode == "block")  -- block: 2. stage'de sandık/blok alınır, gold: sadece gold
    Config.Goodl     = Mode
    SaveConfig()
    RefreshGoodl()
    SetGoodlStatus(Mode == "gold" and "çalışıyor (sadece gold)" or "çalışıyor (gold + blok)")

    if not WasRunning then
        Goodl.Token += 1
        local Token = Goodl.Token
        Goodl.Conn = LocalPlayer.CharacterAdded:Connect(function()
            task.spawn(GoodlFarm, Token)
        end)
        task.spawn(GoodlFarm, Token)
    end
end

GoldOnlyButton.MouseButton1Click:Connect(function()  StartGoodl("gold")  end)
GoldBlockButton.MouseButton1Click:Connect(function() StartGoodl("block") end)


